PORT=5000
JWT_SECRET=change_me_to_a_long_random_string
MONGO_URI=

# Only this account can open Settings, manage Reacher backends and change limits.
# Must match the email of an existing user (registration is disabled).
ADMIN_EMAIL=

# Encrypts the Reacher secrets saved from the Settings page. Falls back to
# JWT_SECRET when unset. Set it before saving secrets if you plan to rotate
# JWT_SECRET later, otherwise stored backend secrets must be re-entered.
SETTINGS_ENCRYPTION_KEY=

# Reacher is the only engine. truemail-go has been removed: every check goes
# through a Reacher backend configured in Settings.

# Reacher backends are normally added in Settings and stored in MongoDB.
# These two only act as a fallback when no backend is configured in the UI.
REACHER_URL=http://localhost:8081
REACHER_SECRET=
REACHER_TIMEOUT_MS=60000

# How long a check waits when every Reacher backend is at its per-minute limit
# before it gives up with a "try again" answer.
REACHER_POOL_MAX_WAIT_MS=60000

BULK_CONCURRENCY=3

# SMTP_PROXY=socks5://127.0.0.1:1080
